# MongoDB Connection
MONGO_URI=mongodb+srv://your-username:your-password@your-cluster.mongodb.net/apple-explorer

# JWT Secret for authentication
JWT_SECRET=your-super-secret-jwt-key-here-make-it-long-and-random

# Session Secret
SESSION_SECRET=your-session-secret-key-here

# Email Configuration (Gmail example)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server Configuration
PORT=3000

# IMPORTANT NOTES:
# 1. Replace MONGO_URI with your actual MongoDB connection string
# 2. Replace JWT_SECRET with a long, random string
# 3. Replace SESSION_SECRET with another long, random string
# 4. For Gmail, you need to:
#    - Enable 2-factor authentication
#    - Generate an "App Password" (not your regular password)
#    - Use the app password in EMAIL_PASS
# 5. For other email providers, update EMAIL_HOST and EMAIL_PORT accordingly
